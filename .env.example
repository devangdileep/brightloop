# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only. Required for portal/team invitations and admin operations.
# NEVER prefix this with NEXT_PUBLIC_ or import it in client components.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Used in auth email redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# FastAPI backend URL — the Next.js frontend routes mutations through this API
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
