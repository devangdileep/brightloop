{
  "name": "brightloop",
  "version": "1.0.0",
  "private": true,
  "description": "Brightloop Software — Subscription Management System",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "dev:backend": "cd backend && uvicorn app.main:app --reload --port 8000",
    "dev:all": "npm run dev:backend & npm run dev",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "typecheck": "npm run typecheck --prefix frontend"
  }
}
